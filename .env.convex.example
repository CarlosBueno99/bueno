# Convex self-hosted backend configuration
# Copy to .env.convex and fill in your values

# Instance identity
INSTANCE_NAME=
INSTANCE_SECRET=

# Release
CONVEX_RELEASE_VERSION_DEV=
ACTIONS_USER_TIMEOUT_SECS=

# Origins
CONVEX_CLOUD_ORIGIN=https://backend.your-domain.xyz
CONVEX_SITE_ORIGIN=https://api.your-domain.xyz

# Database
DATABASE_URL=
POSTGRES_URL=
MYSQL_URL=

# Behaviour
DISABLE_BEACON=
REDACT_LOGS_TO_CLIENT=
DO_NOT_REQUIRE_SSL=

# Logging
RUST_LOG=info
RUST_BACKTRACE=

# S3 storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_STORAGE_EXPORTS_BUCKET=
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
S3_STORAGE_MODULES_BUCKET=
S3_STORAGE_FILES_BUCKET=
S3_STORAGE_SEARCH_BUCKET=
S3_ENDPOINT_URL=
