# ── Client-side (VITE_ prefix = bundled into build) ───────────────────────────
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_API_URL=                   # Backend API origin (e.g. https://api.example.com). Empty = same-origin.
VITE_POSTHOG_KEY=              # Public PostHog project key. Empty = analytics disabled.
VITE_POSTHOG_HOST=             # Ingestion host or proxy, e.g. https://metrics-ingest.example.com.
VITE_POSTHOG_UI_HOST=          # Regional dashboard host, e.g. https://us.posthog.com.

# ── Server-side (read from same file, NOT prefixed with VITE_) ────────────────
FRONTEND_URL=                   # Frontend origin for CORS and Spotify redirects (e.g. https://cool.carlosbueno.xyz)
STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password
CS2_ARCHIVE_INTERNAL_SECRET=your-internal-secret
LOCATION_API_KEY=your-location-api-key

# ── Convex env vars (set via `pnpm exec convex env set`, also mirrored here if running locally) ──
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# STEAM_API_KEY=your_steam_api_key
# CS2_API_BASE_URL=https://api.example.com
# CS2_ARCHIVE_INTERNAL_SECRET=your-internal-secret
